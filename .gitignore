target/
build/
dist/
out/
node_modules/

# Local environment and editor state — never committed.
.env
.env.local
.DS_Store
*.swp
.idea/
.vscode/

# Logs
*.log
target-ide/

# Home-relative caches a tool leaks into the repo root when run with the repo as its cwd
.cache/
.m2/
.local/
